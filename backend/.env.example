# Environment
NODE_ENV=production
PORT=5000
# MongoDB Atlas Production URI - Replace with your actual Atlas connection string
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/skill2cash?retryWrites=true&w=majority&appName=Cluster0
# Generate a secure JWT secret: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_LONG_SECURE_SECRET_MIN_64_CHARS
JWT_EXPIRES_IN=7d
CLIENT_URL=https://your-frontend-domain.com
PLATFORM_WALLET_ID=platform
# Optional bootstrap admin account
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@skill2cash.com
ADMIN_PASSWORD=ChangeMeNow123!
ADMIN_COUNTRY=Cote d Ivoire
ADMIN_LEVEL=Elite
